# ===== SERVIDOR =====
PORT=3001
NODE_ENV=production

# ===== BANCO DE DADOS =====
# Railway: use DATABASE_URL (gerada automaticamente pelo addon PostgreSQL)
# DATABASE_URL=postgresql://user:pass@host:port/dbname
# Local: use as variáveis separadas abaixo
DB_HOST=localhost
DB_PORT=5432
DB_NAME=implocadora
DB_USER=implocadora
DB_PASS=sua_senha_segura
# DB_SSL=false  # Descomente para desabilitar SSL local

# ===== JWT =====
JWT_SECRET=gerar_string_aleatoria_64_chars
JWT_EXPIRES_IN=7d

# ===== ADMIN =====
ADMIN_PASSWORD=senha_segura_do_admin  # Obrigatório na primeira execução para criar o admin

# ===== MERCADO PAGO =====
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxx
MP_WEBHOOK_SECRET=sua_chave_webhook
MP_WEBHOOK_URL=https://locacar-production.up.railway.app/api/webhooks/mp

# ===== FRONTEND =====
FRONTEND_URL=https://seudominio.com

# ===== STORAGE =====
UPLOAD_DIR=./uploads

# ===== CLOUDINARY (para uploads persistentes no Railway) =====
# Crie conta grátis em https://cloudinary.com
# Opção 1: URL completa (mais fácil)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Opção 2: campos separados
# CLOUDINARY_CLOUD_NAME=seu_cloud_name
# CLOUDINARY_API_KEY=sua_api_key
# CLOUDINARY_API_SECRET=seu_api_secret

# ===== EMAIL (PHP/PHPMailer) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=senha_de_app_gmail

# ===== PLATAFORMA EXTERNA =====
EXTERNAL_API_URL=https://outra-plataforma.com/api/motoristas
EXTERNAL_API_KEY=token_da_api_externa

# ===== BANCO SSL =====
# DB_SSL_REJECT_UNAUTHORIZED=false  # Descomente apenas para Railway/Heroku com SSL auto-assinado
